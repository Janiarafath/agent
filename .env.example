# DashWin backend secrets — TEMPLATE ONLY. Real values live in D:\agent\.env
# (copied via USB, NEVER committed). Fill each from its dashboard:
#
# GROQ_API_KEY / GROQ_MODEL .... https://console.groq.com
# TAVILY_API_KEY ............... https://tavily.com
# DATABASE_URL ................. Neon dashboard (pooled connection string)
# MEET_PROVIDER ................ zoom (or jitsi)
# ZOOM_ACCOUNT_ID .............. Zoom Marketplace → Server-to-Server app
# ZOOM_CLIENT_ID ............... same app as above
# ZOOM_CLIENT_SECRET ........... same app as above

GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
TAVILY_API_KEY=
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
MEET_PROVIDER=zoom
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
